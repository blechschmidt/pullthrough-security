          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(pullthrough_upstream_conn_reused_total[5m])) / clamp_min(sum(rate(pullthrough_upstream_conn_acquired_total[5m])),0.001)",
          "refId": "A",
          "instant": false,
          "legendFormat": "reuse"
        }
      ]
