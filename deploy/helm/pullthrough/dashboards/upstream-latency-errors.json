          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (backend) (rate(pullthrough_upstream_request_duration_seconds_sum[5m])) / clamp_min(sum by (backend) (rate(pullthrough_upstream_request_duration_seconds_count[5m])),0.001)",
          "refId": "A",
          "instant": false,
          "legendFormat": "{{backend}}"
        }
      ]
