# Copy to deploy/docker/.env (git-ignored) and fill in as needed. docker-compose
# auto-loads this file and expands the values into the proxy container, where the
# config's ${VAR} placeholders resolve them. All are optional for a basic run.

# Image tag to run (CI publishes :latest and :<sha>/:<semver>).
PULLTHROUGH_IMAGE=ghcr.io/blechschmidt/pullthrough-security:latest

# LLM commit scanning (set scanning.enabled: true in config.docker.yaml to use).
ANTHROPIC_API_KEY=

# Provenance / Git upstreams (raises GitHub API limits; reaches private repos).
GITHUB_TOKEN=

# Tamper-evident audit log HMAC key (set audit.enabled: true to use).
PTS_AUDIT_HMAC_KEY=

# --- Optional backing services (compose profile: extras) -------------------
POSTGRES_USER=pullthrough
POSTGRES_PASSWORD=pullthrough
POSTGRES_DB=pullthrough

# MinIO object store (S3-compatible) credentials.
MINIO_ROOT_USER=pullthrough
MINIO_ROOT_PASSWORD=pullthrough123

# Shared S3 cache backend (set cache.backend: s3 in config.docker.yaml to use).
# These resolve into the proxy via the config's ${VAR} placeholders. With the
# `extras` profile the values default to the MinIO credentials above.
PTS_CACHE_S3_ACCESS_KEY_ID=pullthrough
PTS_CACHE_S3_SECRET_ACCESS_KEY=pullthrough123

# --- Optional monitoring stack (compose profile: monitoring) ---------------
# Grafana admin login (dashboards pre-provisioned). Change before exposing.
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Optional distributed tracing (compose profile: tracing) ---------------
# Uncomment to point the proxy at the bundled OpenTelemetry Collector. Setting
# the endpoint auto-enables tracing; spans are visible in the Jaeger UI on
# :16686. Leave commented when not running the `tracing` profile so the proxy
# does not try to reach an absent collector.
# PTS_TRACING_ENDPOINT=http://otel-collector:4318
# PTS_TRACING_INSECURE=true
# PTS_TRACING_SAMPLER_RATIO=1.0
