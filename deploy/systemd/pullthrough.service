# The pull-through security proxy as a systemd service (docs/systemd.md).
#
# Installed by deploy/systemd/install.sh as /etc/systemd/system/pullthrough.service.
# Change settings with a drop-in (`systemctl edit pullthrough`) rather than by
# editing this file, which the installer replaces on every upgrade.

[Unit]
Description=pullthrough security proxy
Documentation=https://github.com/blechschmidt/pullthrough-security/blob/main/docs/systemd.md
After=network-online.target
Wants=network-online.target
# The cache, audit log and download log live under /var/lib/pullthrough. When
# that is a mount of its own (a data volume), the proxy must not start without
# it and fill the root file system instead.
RequiresMountsFor=/var/lib/pullthrough
# Give up after 5 failed starts in 2 minutes, so a broken host shows up in
# `systemctl status` instead of restarting forever. These are [Unit] settings.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=exec
User=pullthrough
Group=pullthrough

# Validate the configuration first: an edit that does not validate stops here
# with the reason in the journal, instead of in a restart loop.
ExecStartPre=/usr/local/bin/pullthrough verify-config -config /etc/pullthrough/config.yaml
ExecStart=/usr/local/bin/pullthrough -config /etc/pullthrough/config.yaml

# On SIGTERM the proxy finishes in-flight requests for up to
# server.shutdownTimeout (30s) and seals the audit log.
KillSignal=SIGTERM
TimeoutStopSec=45
Restart=on-failure
RestartSec=5s

# /var/lib/pullthrough, created with this owner and mode if missing. It is also
# the service account's home, which git (the Git backend) reads.
StateDirectory=pullthrough
StateDirectoryMode=0750
WorkingDirectory=/var/lib/pullthrough
UMask=0027
LimitNOFILE=65536

# Logs go to the journal: journalctl -u pullthrough -o cat
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pullthrough

# Hardening. The proxy needs no capabilities for a port above 1023; for 443 add
# AmbientCapabilities=CAP_NET_BIND_SERVICE and
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE in a drop-in.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectProc=invisible
ProtectClock=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
