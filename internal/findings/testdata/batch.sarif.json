{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "pullthrough-security",
          "informationUri": "https://github.com/blechschmidt/pullthrough-security",
          "version": "test",
          "rules": [
            {
              "id": "vulnscan/vulnerable-dependency",
              "name": "VulnerableDependency",
              "shortDescription": {
                "text": "A known vulnerability (CVE/advisory) affects this artifact."
              },
              "fullDescription": {
                "text": "The vulnerability-scanning gate generated an SBOM for the artifact and matched one or more of its components against a vulnerability database (OSV by default). Each result names the advisory, the affected component, and the fixed versions when known."
              },
              "help": {
                "text": "Upgrade the affected component to a fixed version, or apply a VEX statement if the artifact is not affected."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#vulnerable-dependency",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "externalReference": "https://osv.dev/",
                "gate": "vulnscan",
                "tags": [
                  "security",
                  "vulnerability",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "vex/suppressed-vulnerability",
              "name": "SuppressedVulnerability",
              "shortDescription": {
                "text": "A vulnerability adjudicated not-affected/fixed by a VEX statement."
              },
              "fullDescription": {
                "text": "A known vulnerability matched the artifact but a VEX (Vulnerability Exploitability eXchange) statement adjudicated it away (not_affected or fixed). It is reported for transparency and flagged as a SARIF suppression so CI does not fail on it."
              },
              "help": {
                "text": "No action required; review the VEX justification if the suppression is unexpected."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#suppressed-vulnerability",
              "defaultConfiguration": {
                "level": "note"
              },
              "properties": {
                "externalReference": "https://openvex.dev/",
                "gate": "vex",
                "tags": [
                  "security",
                  "vulnerability",
                  "vex"
                ]
              }
            },
            {
              "id": "license/non-compliant",
              "name": "NonCompliantLicense",
              "shortDescription": {
                "text": "A component license violates the configured compliance policy."
              },
              "fullDescription": {
                "text": "The license-compliance gate evaluated the artifact's SPDX licenses against the allow/deny/review policy and found a denied (or review-required) license."
              },
              "help": {
                "text": "Remove or replace the offending dependency, or add the license to the allow list / review queue if it is acceptable for this tenant."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#non-compliant-license",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "externalReference": "https://spdx.org/licenses/",
                "gate": "license",
                "tags": [
                  "license",
                  "compliance",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "license/drift",
              "name": "LicenseDrift",
              "shortDescription": {
                "text": "A component's license changed from a previously observed value."
              },
              "fullDescription": {
                "text": "The license gate detected that a component's declared license differs from the value recorded on a prior pull — a supply-chain signal worth review even when the new license is itself allowed."
              },
              "help": {
                "text": "Confirm the license change is legitimate and update the recorded baseline."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#license-drift",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "externalReference": "https://spdx.org/licenses/",
                "gate": "license",
                "tags": [
                  "license",
                  "compliance",
                  "drift"
                ]
              }
            },
            {
              "id": "secretscan/exposed-credential",
              "name": "ExposedCredential",
              "shortDescription": {
                "text": "A credential or secret was detected in the artifact's contents."
              },
              "fullDescription": {
                "text": "The deterministic secret-detection pass matched a high-entropy or pattern-based credential (API key, token, private key) in the artifact's files. The matched value is redacted; the location points at the file."
              },
              "help": {
                "text": "Revoke and rotate the exposed credential immediately, then remove it from the source."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#exposed-credential",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "gate": "secretscan",
                "tags": [
                  "security",
                  "secret",
                  "credential"
                ]
              }
            },
            {
              "id": "sigverify/unverified-signature",
              "name": "UnverifiedSignature",
              "shortDescription": {
                "text": "The artifact's authenticity could not be cryptographically verified."
              },
              "fullDescription": {
                "text": "The signature/attestation gate could not establish a trusted cosign signature or SLSA provenance attestation for the artifact (missing, untrusted identity, broken chain, or a verification error)."
              },
              "help": {
                "text": "Require the publisher to sign the artifact (keyless or keyed cosign) and configure the trusted identity/issuer."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#unverified-signature",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "externalReference": "https://docs.sigstore.dev/",
                "gate": "sigverify",
                "tags": [
                  "security",
                  "signature",
                  "attestation",
                  "slsa"
                ]
              }
            },
            {
              "id": "nameguard/typosquat",
              "name": "Typosquat",
              "shortDescription": {
                "text": "The package name closely resembles a popular package (typosquatting)."
              },
              "fullDescription": {
                "text": "The nameguard gate found the requested package name to be a near-miss of a well-known package, the hallmark of a typosquatting attack."
              },
              "help": {
                "text": "Confirm the intended package name; the look-alike may be malicious."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#typosquat",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "gate": "nameguard",
                "tags": [
                  "security",
                  "typosquat",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "nameguard/dependency-confusion",
              "name": "DependencyConfusion",
              "shortDescription": {
                "text": "The package name shadows an internal/private package namespace."
              },
              "fullDescription": {
                "text": "The nameguard gate found the requested public package name to collide with a configured internal namespace — the dependency-confusion attack pattern."
              },
              "help": {
                "text": "Scope the internal package or pin its source so the public look-alike cannot be substituted."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#dependency-confusion",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "gate": "nameguard",
                "tags": [
                  "security",
                  "dependency-confusion",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "riskscore/threshold-exceeded",
              "name": "RiskThresholdExceeded",
              "shortDescription": {
                "text": "The artifact's composite supply-chain risk score met the admission threshold."
              },
              "fullDescription": {
                "text": "The unified risk-scoring engine folded every gate signal into a composite 0-100 score whose band met or exceeded the configured admission threshold. The message names the top risk drivers."
              },
              "help": {
                "text": "Address the top contributing signals named in the message to lower the composite score below the threshold."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#risk-threshold-exceeded",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "gate": "riskscore",
                "tags": [
                  "security",
                  "risk",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "policyengine/policy-violation",
              "name": "PolicyViolation",
              "shortDescription": {
                "text": "The artifact violated an operator-authored admission policy rule."
              },
              "fullDescription": {
                "text": "The policy-as-code engine evaluated the operator's declarative rules over the aggregated gate signals and a rule fired with a non-allow effect."
              },
              "help": {
                "text": "Review the named policy rule and the signals that triggered it."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#policy-violation",
              "defaultConfiguration": {
                "level": "error"
              },
              "properties": {
                "gate": "policyengine",
                "tags": [
                  "policy",
                  "admission",
                  "supply-chain"
                ]
              }
            },
            {
              "id": "provenance/unverified",
              "name": "UnverifiedProvenance",
              "shortDescription": {
                "text": "The artifact has no verified build-provenance association to a source commit."
              },
              "fullDescription": {
                "text": "The provenance gate could not establish (or could not fully trust) a build-provenance link from the artifact to its source commit."
              },
              "help": {
                "text": "Publish signed build provenance (e.g. GitHub build provenance attestations) so the artifact can be traced to a trusted commit."
              },
              "helpUri": "https://github.com/blechschmidt/pullthrough-security/blob/main/docs/findings.md#unverified-provenance",
              "defaultConfiguration": {
                "level": "warning"
              },
              "properties": {
                "gate": "provenance",
                "tags": [
                  "provenance",
                  "slsa",
                  "supply-chain"
                ]
              }
            }
          ]
        }
      },
