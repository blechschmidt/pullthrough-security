-- shared/bin/nx.js --
#!/usr/bin/env node
'use strict';

const { workspaceRoot } = require('../src/utils/workspace-root');
const { createProjectGraph } = require('../src/project-graph/project-graph');
const { runMany } = require('../src/tasks-runner/run-command');

const [command, ...rest] = process.argv.slice(2);
const graph = createProjectGraph(workspaceRoot);

switch (command) {
  case 'graph':
    process.stdout.write(JSON.stringify(graph, null, 2) + '\n');
    break;
  case 'run-many': {
    const target = rest[0];
    if (!target) {
      process.stderr.write('Usage: nx run-many <target>\n');
      process.exitCode = 1;
      break;
    }
    for (const line of runMany(graph, target, workspaceRoot)) {
      process.stdout.write(line + '\n');
    }
    break;
  }
  default:
    process.stderr.write('Usage: nx <graph|run-many> [target]\n');
    process.exitCode = 1;
}
-- shared/src/utils/workspace-root.js --
'use strict';

const fs = require('fs');
const path = require('path');

// The workspace root is the closest directory, going up from `dir`, that holds
// an nx.json; without one the starting directory is used.
function findWorkspaceRoot(dir) {
  let current = path.resolve(dir);
  for (;;) {
    if (fs.existsSync(path.join(current, 'nx.json'))) return current;
    const parent = path.dirname(current);
    if (parent === current) return path.resolve(dir);
    current = parent;
  }
}

module.exports = { findWorkspaceRoot, workspaceRoot: findWorkspaceRoot(process.cwd()) };
-- shared/src/project-graph/project-graph.js --
'use strict';

const fs = require('fs');
const path = require('path');

// Projects are the directories under packages/ that hold a package.json; an
// edge runs from a project to every workspace project it depends on.
function createProjectGraph(root) {
  const nodes = {};
  const packagesDir = path.join(root, 'packages');
  if (fs.existsSync(packagesDir)) {
    for (const entry of fs.readdirSync(packagesDir, { withFileTypes: true })) {
      const file = path.join(packagesDir, entry.name, 'package.json');
      if (!entry.isDirectory() || !fs.existsSync(file)) continue;
      const pkg = JSON.parse(fs.readFileSync(file, 'utf8'));
      nodes[pkg.name] = {
        name: pkg.name,
        root: path.join('packages', entry.name),
        scripts: pkg.scripts || {},
        deps: pkg.dependencies || {},
      };
    }
  }
  const dependencies = {};
  for (const node of Object.values(nodes)) {
    dependencies[node.name] = Object.keys(node.deps).filter((dep) => nodes[dep]);
  }
  return { nodes, dependencies };
}

module.exports = { createProjectGraph };
-- shared/src/tasks-runner/task-hasher.js --
'use strict';

const crypto = require('crypto');
const fs = require('fs');
const path = require('path');

// A task's hash covers its project's package.json and the hashes of the
// projects it depends on, so a change anywhere upstream changes the hash.
function hashTask(graph, name, root, seen = new Map()) {
  if (seen.has(name)) return seen.get(name);
  const hash = crypto.createHash('sha256');
  hash.update(fs.readFileSync(path.join(root, graph.nodes[name].root, 'package.json')));
  for (const dep of [...graph.dependencies[name]].sort()) {
    hash.update(hashTask(graph, dep, root, seen));
  }
  const digest = hash.digest('hex');
  seen.set(name, digest);
  return digest;
}

module.exports = { hashTask };
-- shared/src/tasks-runner/run-command.js --
'use strict';

const fs = require('fs');
const path = require('path');
const { hashTask } = require('./task-hasher');

// Dependencies first: a depth-first walk of the graph.
function topologicalOrder(graph) {
  const order = [];
  const done = new Set();
  const visit = (name) => {
    if (done.has(name)) return;
    done.add(name);
    for (const dep of graph.dependencies[name]) visit(dep);
    order.push(name);
  };
  Object.keys(graph.nodes).sort().forEach(visit);
  return order;
}

// Lists the tasks `target` would run, in order, marking the ones whose hash is
// already in the local cache.
function runMany(graph, target, root) {
  const cacheDir = path.join(root, 'node_modules', '.cache', 'nx');
  const lines = [];
  for (const name of topologicalOrder(graph)) {
    if (!graph.nodes[name].scripts[target]) continue;
    const cached = fs.existsSync(path.join(cacheDir, hashTask(graph, name, root)));
    lines.push(`nx run ${name}:${target}${cached ? ' [local cache]' : ''}`);
  }
  return lines;
}

module.exports = { topologicalOrder, runMany };
