# File generated from our OpenAPI spec by Stainless. See CONTRIBUTING.md for details.

from __future__ import annotations

from typing import Any, Mapping

import httpx

from . import _exceptions

DEFAULT_TIMEOUT = 60.0
DEFAULT_MAX_RETRIES = 2


class BaseClient:
    def __init__(self, *, version: str, base_url: str | httpx.URL, timeout: float, max_retries: int) -> None:
        self._version = version
        self.base_url = str(base_url).rstrip("/")
        self.timeout = timeout
        self.max_retries = max_retries

    @property
    def default_headers(self) -> dict[str, str]:
        return {"Accept": "application/json", "User-Agent": f"Telnyx/Python {self._version}"}


class SyncAPIClient(BaseClient):
    def post(self, path: str, *, body: Mapping[str, Any] | None = None) -> Any:
        headers = {**self.default_headers, **self.auth_headers}
        with httpx.Client(timeout=self.timeout) as http:
            response = http.post(self.base_url + path, json=body, headers=headers)
        if response.status_code >= 400:
            raise _exceptions.APIStatusError(response.text, status_code=response.status_code)
        return response.json()
