# Ultralytics YOLO, AGPL-3.0 license
"""Download helpers for weights and datasets."""

import shutil
import subprocess
from pathlib import Path
from urllib import parse, request

from ultralytics.utils import GITHUB_ASSETS_NAMES, GITHUB_ASSETS_REPO, LOGGER, USER_CONFIG_DIR


def is_url(url, check=False):
    """Validate that a string is a URL, optionally that it is reachable."""
    try:
        result = parse.urlparse(str(url))
        assert all([result.scheme, result.netloc])
        if check:
            with request.urlopen(url) as response:
                return response.getcode() == 200
        return True
    except Exception:
        return False


def safe_download(url, file=None, dir=None, unzip=True, delete=False, curl=False, retry=3, min_bytes=1e0, exist_ok=False, progress=True):
    """Download a file, retrying, and verify that it is not empty."""
    f = Path(dir or ".") / (file or parse.unquote(url).split("/")[-1].split("?")[0])
    if not f.is_file():
        desc = f"Downloading {url} to '{f}'"
        LOGGER.info(f"{desc}...")
        f.parent.mkdir(parents=True, exist_ok=True)
        for i in range(retry + 1):
            try:
                if curl or i > 0:
                    s = "sS" * (not progress)
                    r = subprocess.run(["curl", "-#", f"-{s}L", url, "-o", f, "--retry", "3", "-C", "-"]).returncode
                    assert r == 0, f"Curl return value {r}"
                else:
                    with request.urlopen(url) as response, open(f, "wb") as f_opened:
                        shutil.copyfileobj(response, f_opened)
                if f.exists() and f.stat().st_size > min_bytes:
                    break
                f.unlink()
            except Exception as e:
                if i >= retry:
                    raise ConnectionError(f"Download failure for {url}") from e
                LOGGER.warning(f"Download failure, retrying {i + 1}/{retry} {url}...")
    return f


def attempt_download_asset(file, repo=GITHUB_ASSETS_REPO, release="v8.3.0"):
    """Return a local path for a released weights file, downloading it when missing."""
    file = Path(str(file).strip().replace("'", ""))
    if file.exists():
        return str(file)
    cached = USER_CONFIG_DIR / "weights" / file.name
    if cached.exists():
        return str(cached)
    if file.name in GITHUB_ASSETS_NAMES:
        url = f"https://github.com/{repo}/releases/download/{release}/{file.name}"
        safe_download(url=url, file=cached.name, dir=cached.parent, min_bytes=1e5)
    return str(cached)
