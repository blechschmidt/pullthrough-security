# Ultralytics YOLO, AGPL-3.0 license
"""Base class shared by every model family."""

from pathlib import Path

from ultralytics.utils import LOGGER


class Model:
    """A model loaded from a .pt checkpoint or built from a .yaml definition."""

    def __init__(self, model="yolo11n.pt", task=None, verbose=False):
        self.model_name = str(model)
        self.task = task
        self.verbose = verbose
        self.ckpt = None
        suffix = Path(self.model_name).suffix
        if suffix in {".yaml", ".yml"}:
            self._new(self.model_name, task=task, verbose=verbose)
        else:
            self._load(self.model_name, task=task)

    def _new(self, cfg, task=None, verbose=False):
        LOGGER.info(f"Building a new model from {cfg}")
        self.cfg = cfg

    def _load(self, weights, task=None):
        from ultralytics.utils.downloads import attempt_download_asset

        self.ckpt_path = attempt_download_asset(weights)
        LOGGER.info(f"Loaded weights from {self.ckpt_path}")

    def predict(self, source=None, stream=False, **kwargs):
        LOGGER.info(f"Predicting on {source}")
        return []

    def train(self, data=None, epochs=100, **kwargs):
        LOGGER.info(f"Training on {data} for {epochs} epochs")
        return {}
