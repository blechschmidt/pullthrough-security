# Ultralytics YOLO, AGPL-3.0 license

from pathlib import Path

from ultralytics.engine.model import Model


class YOLO(Model):
    """YOLO (You Only Look Once) object detection model."""

    def __init__(self, model="yolo11n.pt", task=None, verbose=False):
        """Initialize a YOLO model, switching to YOLOWorld for -world checkpoints."""
        path = Path(model)
        if "-world" in path.stem and path.suffix in {".pt", ".yaml", ".yml"}:
            raise NotImplementedError("YOLOWorld models are not part of this build")
        super().__init__(model=model, task=task, verbose=verbose)

    @property
    def task_map(self):
        """Map head to model, trainer, validator and predictor classes."""
        return {"detect": {}, "segment": {}, "classify": {}, "pose": {}, "obb": {}}
