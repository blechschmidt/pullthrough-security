# Ultralytics YOLO, AGPL-3.0 license
"""Shared helpers: logging, settings and environment checks."""

import logging
import os
import platform
from pathlib import Path

LOGGER = logging.getLogger("ultralytics")
ROOT = Path(__file__).resolve().parents[1]
USER_CONFIG_DIR = Path(os.getenv("YOLO_CONFIG_DIR") or Path.home() / ".config" / "Ultralytics")
GITHUB_ASSETS_REPO = "ultralytics/assets"
GITHUB_ASSETS_NAMES = [f"yolo11{k}.pt" for k in "nsmlx"] + [f"yolov8{k}.pt" for k in "nsmlx"]
MACOS = platform.system() == "Darwin"
LINUX = platform.system() == "Linux"
WINDOWS = platform.system() == "Windows"


def is_online() -> bool:
    """Report whether a network connection is available (respects YOLO_OFFLINE)."""
    if os.environ.get("YOLO_OFFLINE", "").lower() == "true":
        return False
    import socket

    for host in ("192.0.2.1", "198.51.100.1"):  # documentation addresses in the fixture
        try:
            socket.create_connection((host, 80), timeout=2).close()
            return True
        except OSError:
            continue
    return False


def colorstr(*parts) -> str:
    """Return the last argument wrapped in the ANSI codes named by the others."""
    *args, string = parts
    codes = {"blue": "\033[34m", "bold": "\033[1m", "red": "\033[31m", "end": "\033[0m"}
    return "".join(codes.get(a, "") for a in args) + f"{string}" + codes["end"]
