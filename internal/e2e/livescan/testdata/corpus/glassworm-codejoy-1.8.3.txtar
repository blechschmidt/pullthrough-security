-- benign/extension.js --
'use strict';

const vscode = require('vscode');
const { loadWorkflow, describeWorkflow } = require('./workflow');

function currentFolder() {
  const folders = vscode.workspace.workspaceFolders;
  return folders && folders.length > 0 ? folders[0].uri.fsPath : null;
}

function activate(context) {
  const status = vscode.window.createStatusBarItem(vscode.StatusBarAlignment.Left, 50);
  status.command = 'codejoy.openProjectWorkflow';
  context.subscriptions.push(status);

  const refresh = () => {
    const folder = currentFolder();
    if (!folder) {
      status.hide();
      return;
    }
    status.text = '$(rocket) ' + describeWorkflow(loadWorkflow(folder));
    status.show();
  };

  context.subscriptions.push(
    vscode.commands.registerCommand('codejoy.openProjectWorkflow', () => {
      const folder = currentFolder();
      if (!folder) {
        vscode.window.showInformationMessage('Open a folder to see its CodeJoy workflow.');
        return;
      }
      vscode.window.showInformationMessage(describeWorkflow(loadWorkflow(folder)));
    }),
    vscode.commands.registerCommand('codejoy.projectWorkflow.focus', refresh),
    vscode.workspace.onDidChangeWorkspaceFolders(refresh)
  );

  refresh();
}

function deactivate() {}

module.exports = { activate, deactivate };
